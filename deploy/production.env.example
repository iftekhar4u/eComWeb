# Host environment reference. Existing database: preserve the ORIGINAL keys.
NODE_ENV=production
PORT=5000
CLIENT_URL=https://shop.example.com
MONGO_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER/aurelia_dev
SESSION_SECRET=replace-with-the-original-session-secret
MFA_ENCRYPTION_KEY=replace-with-the-original-mfa-encryption-key
PAYMENT_ENCRYPTION_KEY=replace-with-the-original-payment-encryption-key
# Keep blank if existing email settings use SESSION_SECRET as their key.
EMAIL_ENCRYPTION_KEY=
INTEGRATIONS_DIRECTORY=/var/lib/aurelia
# One trusted ingress; Node port must not be publicly reachable directly.
TRUST_PROXY=1
PAYMENT_PUBLIC_ORIGIN=https://shop.example.com
COD_ENABLED=false
EMAIL_ENABLED=false
GOOGLE_AUTH_ENABLED=false
