NODE_ENV=development
PORT=5000
# Local MongoDB Windows service, replica set rs0 (port 27017).
# Atlas replica-set connection strings also work. URI-encode passwords containing special characters.
MONGO_DEV_URI=mongodb://127.0.0.1:27017/aurelia_dev?replicaSet=rs0&directConnection=true
MONGO_TEST_URI=mongodb://127.0.0.1:27017/aurelia_test?replicaSet=rs0&directConnection=true
# Production uses MONGO_URI instead of MONGO_DEV_URI. Keep actual credentials out of Git.
# MONGO_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER/aurelia_prod
CLIENT_URL=http://localhost:5173
# npm run setup:env generates random values in backend/.env. Do not reuse these placeholders.
SESSION_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Set to the known number of trusted proxy hops in your deployment (usually 1).
TRUST_PROXY=0
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Razorpay: leave blank until you create an account. Never put these secrets in frontend env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CHECKOUT_RESERVATION_MINUTES=30
# Enable only if the store actually accepts cash on delivery.
COD_ENABLED=false

# Optional: persistent private integration settings directory (absolute path recommended).
# INTEGRATIONS_DIRECTORY=
# Emergency only: use the original .env database instead of the admin-selected Atlas URI.
INTEGRATIONS_IGNORE_DATABASE=false

# Optional Cloudinary defaults. Admin-saved credentials override these values.
# Keep the API secret on the backend only; never use VITE_ variables for credentials.
    CLOUDINARY_CLOUD_NAME=
    CLOUDINARY_API_KEY=
    CLOUDINARY_API_SECRET=
    CLOUDINARY_FOLDER=aurelia

# Optional email defaults. Saved Admin > Email settings take precedence.
# Keep the existing EMAIL_ENCRYPTION_KEY/SESSION_SECRET stable for saved mail.
EMAIL_ENABLED=false
EMAIL_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_SUPPORT=

# Payment administration: generate once, back up securely, and keep stable.
# Routine Razorpay keys and business settings belong in Admin > Payments.
PAYMENT_ENCRYPTION_KEY=
# Public BACKEND/proxied origin that receives /api/payments/razorpay/webhook
PAYMENT_PUBLIC_ORIGIN=http://localhost:5000
# Optional legacy environment profile merchant association; use acc_... from Dashboard.
RAZORPAY_ACCOUNT_ID=
