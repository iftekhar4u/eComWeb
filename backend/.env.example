NODE_ENV=development
PORT=5000
MONGO_DEV_URI=mongodb://127.0.0.1:27017/aurelia_dev
MONGO_TEST_URI=mongodb://127.0.0.1:27017/aurelia_test
# After approved MongoDB authentication setup, replace the two values with separate users:
# MONGO_DEV_URI=mongodb://aurelia_runtime_dev:REPLACE_ME@127.0.0.1:27017/aurelia_dev?authSource=aurelia_dev
# MONGO_TEST_URI=mongodb://aurelia_runtime_test:REPLACE_ME@127.0.0.1:27017/aurelia_test?authSource=aurelia_test
# Set MONGO_URI only for a deliberately configured environment; local scripts reject aurelia_prod.
# MONGO_URI=mongodb://username:password@127.0.0.1:27017/aurelia_dev?authSource=aurelia_dev
CLIENT_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
TRUST_PROXY=0
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
